# Copy to `.env` (which is gitignored) and adjust if needed:  cp .env.example .env
# These are LOCAL DEV credentials only — never real secrets.

# --- PostgreSQL (consumed by docker compose) ---
POSTGRES_USER=casepilot
POSTGRES_PASSWORD=casepilot
POSTGRES_DB=casepilot
POSTGRES_PORT=5432

# --- App database connection (psycopg 3 driver) ---
# Host-run app -> Postgres published on localhost. Note the "+psycopg" driver suffix.
DATABASE_URL=postgresql+psycopg://casepilot:casepilot@localhost:5432/casepilot
